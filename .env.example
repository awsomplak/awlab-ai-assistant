# ── Database ──────────────────────────────────────────────────────
# Override the directory where agent-recall databases are stored.
# Default: <workspace_path>/.ai/memory/
# DB_PATH=/example/custom/db/path

# ── Logging ──────────────────────────────────────────────────────
# Enable or disable logging entirely.
# Values: true (default) | false
LOG_ENABLED=true

# Log level. Case-insensitive ("info", "DEBUG", "warning", "error").
# - DEBUG: includes debug-level messages
# - INFO / WARNING / ERROR: progressively filter out lower levels
# Default: INFO
LOG_LEVEL=INFO

# ── Asynchronous Logging ──────────────────────────────────────────
# Enable non-blocking asynchronous logging to prevent slow I/O from
# impacting MCP event loop performance.
# Values: 1 (enable async) | 0 (synchronous)
# Default: 0
# LOG_ASYNC=1

# ── Environment Mode ──────────────────────────────────────────────
# Sets the running mode of the MCP server.
# Values: production | development
# AWLAB_ENV=production

# ── Code Knowledge Graph (Graphify) ───────────────────────────────
# Define custom output directory for the generated code graph.
# Default: .ai/codegraph
# GRAPHIFY_OUT=.ai/codegraph

# Disable auto-backup of the old graph before rebuilding.
# Values: 1 (disable) | 0 (enable)
# Default: 1
# GRAPHIFY_NO_BACKUP=1

# Maximum number of files processed per chunked graph build iteration.
# Lower sizes preserve memory on extremely large projects.
# Default: 200
# GRAPH_CHUNK_SIZE=200

# Maximum number of files to process in the FIRST chunked build.
# Set a limit to prevent the initial scan from taking too long.
# Default: (unlimited)
# GRAPH_MAX_FILES=1000

# ── Optional LLM Configuration (Memory Graph Extraction) ──────
# The LLM configuration is strictly used for Memory Graph Extraction.
# It uses an LLM to intelligently extract structured observations and
# entities from raw text to build your SQLite Memory Bank.
#
# NOTE: This has nothing to do with the Code Knowledge Graph (LanceDB),
# which always runs 100% locally using the 'BAAI/bge-small-en-v1.5' model.
# If these LLM variables are left blank, the memory extractor simply falls
# back to standard deterministic logic (fully offline).

# Set the LLM API Key (e.g., OpenAI API key).
# LLM_API_KEY=your_api_key_here

# Base URL if using a custom endpoint (like OpenAI compatible proxies).
# LLM_BASE_URL=https://api.openai.com/v1

# The LLM Model name to use (e.g., gpt-4o-mini).
# LLM_MODEL=gpt-4o-mini

