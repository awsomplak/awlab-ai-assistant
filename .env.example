# ── Database ──────────────────────────────────────────────────────
# Override the directory where agent-recall databases are stored.
# Default: <workspace_path>/.ai/memory/
# DB_PATH=/example/custom/db/path

# ── Logging ──────────────────────────────────────────────────────
# Enable or disable logging entirely.
# Values: true (default) | false
LOG_ENABLED=true

# Log level. Case-insensitive ("info", "DEBUG", "warning", "error").
# - DEBUG: includes debug-level messages
# - INFO / WARNING / ERROR: progressively filter out lower levels
# Default: INFO
LOG_LEVEL=INFO